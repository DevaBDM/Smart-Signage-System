generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Group {
  id                 Int           @id @default(autoincrement())
  name               String        @unique
  description        String?
  signage_state      SignageState  @default(NORMAL)
  created_at         DateTime      @default(now())
  devices            Device[]      @relation("GroupDevices")
  device_memberships DeviceGroup[]
  playlists          Playlist[]
  posts              Post[]
  users              User[]
  user_memberships   UserGroup[]
  live_streams       LiveStream[]
}

model UserGroup {
  id         Int      @id @default(autoincrement())
  user_id    Int
  group_id   Int
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  group      Group    @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@unique([user_id, group_id])
  @@index([user_id])
  @@index([group_id])
}

model DeviceGroup {
  id         Int      @id @default(autoincrement())
  device_id  Int
  group_id   Int
  created_at DateTime @default(now())
  device     Device   @relation(fields: [device_id], references: [id], onDelete: Cascade)
  group      Group    @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@unique([device_id, group_id])
  @@index([group_id])
}

model User {
  id                     Int      @id @default(autoincrement())
  username               String   @unique
  password_hash          String
  role                   Role     @default(creator)
  group_id               Int?
  auto_approve           Boolean  @default(false)
  can_manage_other_posts Boolean  @default(false)
  creator_priority       Int          @default(1)
  control_lock_minutes   Int          @default(120)
  max_signage_state      SignageState @default(NORMAL)
  created_at             DateTime     @default(now())
  device_locks           Device[] @relation("DeviceControlLock")
  posts                  Post[]
  live_streams           LiveStream[]
  group                  Group?   @relation(fields: [group_id], references: [id])
  managed_groups         UserGroup[]

  @@index([role])
  @@index([group_id])
}

model Post {
  id                   Int                 @id @default(autoincrement())
  title                String
  slug                 String              @unique
  description_markdown String?
  group_id             Int
  created_by           Int
  allowed_on_feed      Boolean             @default(false)
  allowed_on_signage   Boolean             @default(false)
  requested_feed       Boolean             @default(false)
  requested_signage    Boolean             @default(false)
  status               PostStatus          @default(draft)
  signage_state        SignageState        @default(NORMAL)
  created_at           DateTime            @default(now())
  updated_at           DateTime            @updatedAt
  playlist_items       PlaylistItem[]
  author               User                @relation(fields: [created_by], references: [id])
  group                Group               @relation(fields: [group_id], references: [id])
  images               PostImage[]
  signage_assets       SignageAsset[]
  signage_deployments  SignageDeployment[]
  signage_metadata     SignageMetadata?
  live_stream_id       Int?
  live_stream          LiveStream? @relation("PostLiveStream", fields: [live_stream_id], references: [id], onDelete: SetNull)
  attachments          PostAttachment[]

  @@index([status])
  @@index([group_id])
  @@index([created_by])
  @@index([allowed_on_feed])
  @@index([allowed_on_signage])
  @@index([live_stream_id])
}

model LiveStream {
  id             Int               @id @default(autoincrement())
  title          String
  stream_type    LiveStreamType
  source_url     String?
  relay_url      String?
  stream_key     String?           @unique
  thumbnail_path String?
  status         LiveStreamStatus  @default(idle)
  last_error     String?
  last_seen      DateTime?
  group_id       Int
  created_by     Int
  created_at     DateTime          @default(now())
  updated_at     DateTime          @updatedAt
  group          Group             @relation(fields: [group_id], references: [id])
  author         User              @relation(fields: [created_by], references: [id])
  posts          Post[]            @relation("PostLiveStream")

  @@index([group_id])
  @@index([status])
}

model PostImage {
  id               Int       @id @default(autoincrement())
  post_id          Int
  image_path       String
  media_type       MediaType @default(IMAGE)
  duration_seconds Int?
  order_index      Int       @default(0)
  created_at       DateTime  @default(now())
  post             Post      @relation(fields: [post_id], references: [id], onDelete: Cascade)
}

model PostAttachment {
  id             Int      @id @default(autoincrement())
  post_id        Int
  file_path      String
  file_name      String
  mime_type      String
  file_size      Int      @default(0)
  extracted_text String?  @db.Text
  created_at     DateTime @default(now())
  post           Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@index([post_id])
}

model SignageMetadata {
  id               Int       @id @default(autoincrement())
  post_id          Int       @unique
  duration_seconds Int       @default(10)
  start_date       DateTime?
  end_date         DateTime?
  priority         Int       @default(1)
  display_group    String?
  is_enabled       Boolean   @default(true)
  play_order       Int       @default(0)
  nocache          Boolean   @default(false)
  skip_asset_check Boolean   @default(false)
  created_at       DateTime  @default(now())
  post             Post      @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@index([post_id])
}

model Device {
  id                    Int                 @id @default(autoincrement())
  device_name           String
  group_id              Int?
  ip_address            String
  location              String?
  all_groups            Boolean             @default(false)
  status                String              @default("offline")
  last_seen             DateTime?
  current_playlist      Int?
  is_approved           Boolean             @default(false)
  pending_name          String?
  pending_ip            String?
  pending_location      String?
  device_token          String?
  control_lock_user_id  Int?
  control_lock_priority Int?
  control_lock_until    DateTime?
  control_lock_action   String?
  created_at            DateTime            @default(now())
  control_lock_user     User?               @relation("DeviceControlLock", fields: [control_lock_user_id], references: [id], onDelete: SetNull)
  group                 Group?              @relation("GroupDevices", fields: [group_id], references: [id])
  groups                DeviceGroup[]
  error_logs            ErrorLog[]
  sensor_logs           SensorLog[]
  signage_assets        SignageAsset[]
  deployments           SignageDeployment[]

  @@index([status])
  @@index([group_id])
  @@index([is_approved])
}

model SignageDeployment {
  id               Int       @id @default(autoincrement())
  device_id        Int
  post_id          Int
  duration_seconds Int       @default(10)
  start_date       DateTime?
  end_date         DateTime?
  priority         Int       @default(1)
  display_group    String?
  is_enabled       Boolean   @default(true)
  play_order       Int       @default(0)
  nocache          Boolean   @default(false)
  skip_asset_check Boolean   @default(false)
  status           String    @default("pending")
  last_error       String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  device           Device    @relation(fields: [device_id], references: [id], onDelete: Cascade)
  post             Post      @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@unique([device_id, post_id])
  @@index([device_id, status])
  @@index([post_id])
}

model SignageAsset {
  id             Int       @id @default(autoincrement())
  device_id      Int
  post_id        Int?
  asset_id       String
  asset_name     String?
  image_url      String?
  mimetype       String?
  duration       Int?
  is_enabled     Boolean   @default(true)
  is_active      Boolean?
  play_order     Int?
  start_date     DateTime?
  end_date       DateTime?
  last_synced_at DateTime  @default(now())
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  device         Device    @relation(fields: [device_id], references: [id], onDelete: Cascade)
  post           Post?     @relation(fields: [post_id], references: [id], onDelete: SetNull)

  @@unique([device_id, asset_id])
  @@index([post_id])
  @@index([device_id])
}

model SensorLog {
  id         Int      @id @default(autoincrement())
  device_id  Int
  motion     Boolean  @default(false)
  brightness Int      @default(0)
  rain       Boolean  @default(false)
  created_at DateTime @default(now())
  device     Device   @relation(fields: [device_id], references: [id], onDelete: Cascade)
}

model ErrorLog {
  id         Int      @id @default(autoincrement())
  device_id  Int
  error_type String
  message    String
  created_at DateTime @default(now())
  device     Device   @relation(fields: [device_id], references: [id], onDelete: Cascade)
}

model Playlist {
  id         Int            @id @default(autoincrement())
  name       String
  group_id   Int
  created_at DateTime       @default(now())
  group      Group          @relation(fields: [group_id], references: [id])
  items      PlaylistItem[]
}

model PlaylistItem {
  id               Int      @id @default(autoincrement())
  playlist_id      Int
  post_id          Int
  duration_seconds Int      @default(10)
  order_index      Int      @default(0)
  playlist         Playlist @relation(fields: [playlist_id], references: [id], onDelete: Cascade)
  post             Post     @relation(fields: [post_id], references: [id])
}

enum Role {
  admin
  creator
  viewer
}

enum PostStatus {
  draft
  published
}

enum SignageState {
  EMERGENCY
  SECURITY_RISK
  BREAKING_NEWS
  NORMAL
}

enum LiveStreamType {
  HLS
  RTSP
  YOUTUBE
  RTMP
}

enum LiveStreamStatus {
  idle
  starting
  online
  offline
  error
}

enum MediaType {
  IMAGE
  VIDEO
  LIVE_STREAM
}
